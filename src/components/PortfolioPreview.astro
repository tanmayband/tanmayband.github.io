---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ThumbnailPreview from './ThumbnailPreview.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<ThumbnailPreview
	src={data.img}
	alt={data.img_alt || ''}
	title={data.title}
	icon={data.softwares[0]}
	href={`/work/${id}`}
>
	<div slot="description">
		<ul class="summary">
			{data.summary.map((line) => <li>{line}</li>)}
		</ul>
	</div>

</ThumbnailPreview>

<style>
	.summary {
		list-style: square;
		
		/* to decrease the indent so as to match the left-margin and -padding coming from .description */
		padding-left: 1rem;
	}
</style>
